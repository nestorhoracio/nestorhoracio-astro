---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: "website" | "article";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image, type = "website", jsonLd } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image ?? "/images/og/og-default.png", Astro.site);
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/logo/isotipo-full-color.png" />
    <link rel="apple-touch-icon" href="/images/logo/isotipo-full-color.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Blinker regular es la fuente de cuerpo — precargarla evita el
         render-blocking que tenía el theme original. Ver CLAUDE.md. -->
    <link
      rel="preload"
      href="/fonts/blinker-v14-latin_latin-ext-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={imageURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    {jsonLdList.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
    ))}

    <!-- Google Analytics (GA4). El loader remoto va is:inline a propósito
         (Astro no debe tocarlo: tiene que quedar "async" tal cual, sin
         type="module"). El script de abajo, en cambio, NO lleva is:inline
         para que Astro lo externalice a un archivo propio -- el CSP de
         public/.htaccess no tiene 'unsafe-inline' en script-src, así que un
         <script> con código inline quedaría bloqueado por el navegador
         (mismo problema que ya pasó con Header.astro, ver CLAUDE.md). -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-78H35GJS30"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag() {
        window.dataLayer.push(arguments);
      };
      window.gtag("js", new Date());
      window.gtag("config", "G-78H35GJS30");

      // Clic en cualquier link a WhatsApp o a redes sociales, en cualquier
      // parte del sitio (footer, hero, CTAs de los posts del blog, etc.) --
      // delegado en document así no hace falta enganchar cada link a mano.
      document.addEventListener("click", (event) => {
        const target = event.target as HTMLElement | null;
        const link = target?.closest("a[href]") as HTMLAnchorElement | null;
        if (!link) return;

        const href = link.href;

        if (href.includes("wa.me") || href.includes("api.whatsapp.com")) {
          window.gtag("event", "whatsapp_click", {
            link_url: href,
            link_text: link.textContent?.trim().slice(0, 100) || "",
            page_path: window.location.pathname,
          });
          return;
        }

        if (href.includes("facebook.com") || href.includes("instagram.com")) {
          window.gtag("event", "social_click", {
            network: href.includes("facebook.com") ? "facebook" : "instagram",
            link_url: href,
            page_path: window.location.pathname,
          });
        }
      });
    </script>
  </head>
  <body>
    <Header />
    <slot />
    <Footer />
  </body>
</html>
