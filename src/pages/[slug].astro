---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import { Image, getImage } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import { articleSchema, creativeWorkSchema } from "../lib/seo";
import "../styles/blog.css";

type BlogProps = { kind: "blog"; entry: CollectionEntry<"blog"> };
type PortfolioProps = { kind: "portfolio"; entry: CollectionEntry<"portfolio"> };
type Props = BlogProps | PortfolioProps;

export async function getStaticPaths() {
  const blogEntries = (await getCollection("blog")).map((entry) => ({
    params: { slug: entry.id },
    props: { kind: "blog" as const, entry },
  }));
  const portfolioEntries = (await getCollection("portfolio")).map((entry) => ({
    params: { slug: entry.id },
    props: { kind: "portfolio" as const, entry },
  }));
  return [...blogEntries, ...portfolioEntries];
}

const { kind, entry } = Astro.props as Props;
const { Content } = await render(entry);

const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("es-UY", { day: "2-digit", month: "2-digit", year: "numeric" }).format(date);

const description =
  kind === "blog" ? entry.data.description : entry.data.summary;

const pageURL = new URL(`/${entry.id}/`, Astro.site).toString();
const ogImage = entry.data.cover ? await getImage({ src: entry.data.cover, width: 1200, height: 630 }) : null;
const ogImageURL = ogImage ? new URL(ogImage.src, Astro.site).toString() : undefined;

const jsonLd =
  kind === "blog"
    ? articleSchema({
        title: entry.data.title,
        description,
        url: pageURL,
        image: ogImageURL ?? new URL("/images/logo/isotipo-full-color.png", Astro.site).toString(),
        datePublished: entry.data.date.toISOString(),
      })
    : creativeWorkSchema({
        title: entry.data.title,
        description,
        url: pageURL,
        image: ogImageURL ?? new URL("/images/logo/isotipo-full-color.png", Astro.site).toString(),
      });
---

<Layout
  title={`${entry.data.title} — Néstor Horacio Díaz`}
  description={description}
  image={ogImageURL}
  type={kind === "blog" ? "article" : "website"}
  jsonLd={jsonLd}
>
  <main class="post-entry">
    <h1>{entry.data.title}</h1>

    {kind === "blog" && (
      <p class="post-entry__meta">
        {entry.data.category} · <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
      </p>
    )}

    {kind === "portfolio" && <p class="post-entry__meta">{entry.data.summary}</p>}

    {entry.data.cover && (
      <div class="post-entry__cover">
        <Image src={entry.data.cover} alt="" width={960} height={440} />
      </div>
    )}

    {kind === "portfolio" && (
      <p><a class="btn" href={entry.data.liveUrl} target="_blank" rel="noopener">Ver sitio en vivo</a></p>
    )}

    <div class="post-entry__body">
      <Content />
    </div>

    {kind === "portfolio" && (
      <p class="post-entry__meta"><strong>Stack tecnológico:</strong> {entry.data.stack}</p>
    )}
  </main>
</Layout>
